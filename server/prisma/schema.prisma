datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  student
  recruiter
  admin
}

enum DriveStatus {
  Draft
  Active
  Completed
  Cancelled
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(student)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model PlacementDrive {
  id                   String      @id @default(uuid())
  name                 String
  companies            String[]
  jobOpeningsCount     Int         @default(0) @map("job_openings_count")
  registrationDeadline DateTime    @map("registration_deadline")
  eventStartDate       DateTime    @map("event_start_date")
  eventEndDate         DateTime    @map("event_end_date")
  rounds               String[]
  eligibleBranches     String[]    @map("eligible_branches")
  minCgpa              Float       @default(0.0) @map("min_cgpa")
  status               DriveStatus @default(Active)
  description          String?
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  @@map("placement_drives")
}
