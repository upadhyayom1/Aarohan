# ─────────────────────────────────────────────────────────────
# CampusLink AI Service — environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
ENVIRONMENT=development          # development | production (production disables /docs)
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database (SAME PostgreSQL the Node.js/Prisma backend uses) ─
# Option A: reuse the exact DATABASE_URL from the Node backend's .env
#           (Prisma-only params such as ?schema=public are handled).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/campuslink?schema=public
# Option B: individual parts (used only when DATABASE_URL is empty)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=campuslink
# DB_USER=
# DB_PASSWORD=
# DB_SCHEMA=public
# DB_SSLMODE=prefer
DB_POOL_SIZE=5
DB_STATEMENT_TIMEOUT_MS=15000

# Prisma model/table names (defaults match `model User/Student/Job/Application`)
TABLE_USER=User
TABLE_STUDENT=Student
TABLE_JOB=Job
TABLE_APPLICATION=Application
# Optional: override column discovery, e.g. {"student":{"cgpa":["gpaScore"]}}
COLUMN_OVERRIDES_JSON=

# ── Resume files (written by the Node.js backend, read-only here) ──
# Folder that contains the uploaded PDFs. Node stores a path in the DB;
# it is resolved INSIDE this folder (path traversal is blocked).
RESUME_STORAGE_DIR=../backend/uploads/resumes
MAX_RESUME_MB=5
MAX_PDF_PAGES=10

# ── Auth ─────────────────────────────────────────────────────
# Must equal the secret/algorithm the Node.js backend uses to sign JWTs.
JWT_SECRET=change-me-same-as-node-backend
JWT_ALGORITHM=HS256
JWT_USER_ID_CLAIMS=id,userId,user_id,sub
JWT_ROLE_CLAIM=role
# Shared secret for server-to-server calls from the Node backend
# (header: X-Internal-Api-Key). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
# DEV ONLY — disables all auth checks. Never true in production.
AUTH_DISABLED=false

# ── Gemini ───────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=40
GEMINI_MAX_RETRIES=2

# ── Matching ─────────────────────────────────────────────────
# sentence-transformers (local, default) | gemini | tfidf
EMBEDDING_BACKEND=sentence-transformers
ST_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Leave empty to use the backend's tuned default
SEMANTIC_MATCH_THRESHOLD=
RELATED_MATCH_THRESHOLD=
# Score weights (normalised automatically)
WEIGHT_SKILLS=0.60
WEIGHT_CONTEXT=0.25
WEIGHT_EVIDENCE=0.15
WARMUP_MODELS=false

# ── Local result cache (files only — NOT the database) ───────
CACHE_DIR=.cache
CACHE_ENABLED=true

# ── Optional: calls back into the Node.js backend ────────────
# Disabled by default. Agree the endpoints with the backend owner first.
NODE_BACKEND_URL=http://localhost:8000
NODE_CALLBACKS_ENABLED=false
NODE_PATH_RESUME_ANALYSIS=/api/v1/internal/students/{student_id}/resume-analysis
NODE_PATH_MATCH_RESULT=/api/v1/internal/applications/{application_id}/match-result
NODE_CALLBACK_METHOD=PUT
NODE_TIMEOUT_SECONDS=8
