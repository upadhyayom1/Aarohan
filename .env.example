# -------------------------------------------------------------
# Aarohan Production / Docker Environment Configuration
# -------------------------------------------------------------

# PostgreSQL Connection String (e.g. Neon or self-hosted PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require

# Secure JWT Authentication Secret (minimum 32 characters)
JWT_SECRET=production_aarohan_jwt_secret_key_32_chars_min

# Google Gemini API Key for ATS evaluation and LLM matching
GEMINI_API_KEY=your_gemini_api_key_here
